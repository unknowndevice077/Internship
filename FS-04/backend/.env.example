# Copy to .env for local development. DJANGO_DEBUG defaults to off, so keep it at 1 here.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_CONN_MAX_AGE=0
DATABASE_URL=postgres://sprintboard:sprintboard@localhost:5433/sprintboard
REDIS_URL=redis://localhost:6380/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sprintboard <no-reply@sprintboard.local>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MAX_ATTACHMENT_MB=10

# Attachments go to local disk unless a bucket is set (S3, R2 or MinIO).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SENTRY_DSN=

# Sign-in protection and housekeeping.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
REQUIRE_VERIFIED_EMAIL=1
AUDIT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90

# Set to scan uploads with ClamAV.
CLAMD_HOST=
CLAMD_PORT=3310

# Rate limits, e.g. 10/min. NUM_PROXIES is how many proxies sit in front of the app.
THROTTLE_AUTH_RATE=10/min
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=600/min
NUM_PROXIES=
WEBHOOK_ALLOW_PRIVATE_URLS=1
