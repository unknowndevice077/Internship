PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vendora
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# empty = in-memory mock (fine for local dev, not for production)
REDIS_URL=redis://127.0.0.1:6379
# empty = search falls back to MongoDB text search
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=products

# empty = images are saved to ./uploads
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Stripe test mode keys (sk_test_...). Empty = mock payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
COMMISSION_RATE=0.10

# empty = emails are logged instead of sent, e.g. smtp://user:pass@smtp.resend.com:587
SMTP_URL=
MAIL_FROM=Vendora <no-reply@vendora.test>

# error tracking, optional
SENTRY_DSN=
LOG_LEVEL=info
